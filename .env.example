# ============================================================
#  Maika AI — cấu hình LLM (chuẩn OpenAI-compatible, ưu tiên MIỄN PHÍ)
#  Sao chép file này thành .env.local (đã gitignore qua *.local)
# ============================================================

# ---- Cách 1 (DEV/TEST tại máy): gọi trực tiếp nhà cung cấp free ----
# Google Gemini (free, không cần thẻ) — lấy key: https://aistudio.google.com/apikey
VITE_MAIKA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
VITE_MAIKA_MODEL=gemini-2.0-flash
VITE_MAIKA_API_KEY=

# Hoặc Groq (free): BASE_URL=https://api.groq.com/openai/v1  MODEL=llama-3.3-70b-versatile
# Hoặc OpenRouter (có model :free): BASE_URL=https://openrouter.ai/api/v1

# ---- Cách 2 (PHÁT HÀNH .exe/.apk): dùng proxy để giấu key ----
# Proxy forward tới nhà cung cấp; app chỉ gọi proxy, không chứa key.
# VITE_MAIKA_PROXY_URL=https://<app>.vercel.app/api/maika

# Để trống key & proxy → Maika chạy engine offline (rule-based, không cần mạng).
