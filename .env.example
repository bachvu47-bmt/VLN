# ============================================================
#  Maika AI — Google Gemini (miễn phí, không cần thẻ)
#  Sao chép file này thành .env.local (đã gitignore qua *.local)
#  Lấy key: https://aistudio.google.com/apikey
# ============================================================
VITE_GEMINI_API_KEY=

# Model chat — gemini-1.5-flash / gemini-2.0-flash đã bị Google gỡ (404).
# "gemini-flash-latest" luôn trỏ bản Flash mới nhất còn hoạt động.
VITE_GEMINI_MODEL=gemini-flash-latest

# Model embedding cho bộ nhớ vector (AI tự học / RAG)
VITE_GEMINI_EMBED_MODEL=gemini-embedding-001

# Model phân tích Multimodal (ảnh hiện trường, tài liệu) — Gemini Flash
# VITE_GEMINI_MULTIMODAL_MODEL=gemini-flash-latest

# Groq (free) — BRAIN CHÍNH cho chat chữ + Whisper chuyển giọng nói: https://console.groq.com/keys
VITE_GROQ_API_KEY=
# Danh sách model chat (chung với Maika trên web): supabase/functions/_shared/maikaNao.js

# Bộ não chung Maika (Supabase) — app + web cùng tri thức; chat đi qua hàm máy chủ "maika"
# (key AI nằm trong Secrets của Supabase). Tự ghi bởi: node scripts/setup-supabase.mjs
# VITE_SUPABASE_URL=https://<ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Báo cáo bán hàng Google Sheets (ID trong link .../spreadsheets/d/<ID>/...) — chia sẻ "Bất kỳ ai có link · Người xem"
VITE_SHEET_BAO_CAO_ID=
# VITE_SHEET_BAO_CAO_TAB=Báo cáo ngày

# (Tùy chọn) nguồn đồng bộ sản phẩm & proxy vượt CORS cho bản web
# VITE_VLN_API=https://vatlieunha.vn/wp-json/wc/store/v1
# VITE_VLN_PROXY=https://<app>.vercel.app/api/products

# ⚠️ Biến VITE_* được đóng gói vào .exe/.apk — ai giải nén app đều đọc được key.
#    Chỉ dùng key free, giới hạn quota trong Google AI Studio.
