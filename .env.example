# ============================================================
#  Trợ lý Maika — cấu hình Claude API
#  Sao chép file này thành .env.local (đã được gitignore qua *.local)
# ============================================================

# ---- Cách 1 (KHUYẾN NGHỊ, an toàn) ----
# Trỏ tới proxy server giữ API key (xem server/maika-proxy.example.mjs).
# App chỉ gọi proxy, KHÔNG chứa API key → không bị lộ.
VITE_MAIKA_PROXY_URL=

# ---- Cách 2 (CHỈ nội bộ / thử nghiệm) ----
# Gọi trực tiếp Anthropic từ trình duyệt. ⚠️ API key SẼ bị nhúng vào bundle
# client và có thể bị trích xuất. Không dùng cho bản phát hành rộng.
VITE_ANTHROPIC_API_KEY=

# Tùy chọn: đổi model (mặc định claude-opus-4-8)
VITE_MAIKA_MODEL=claude-opus-4-8

# Nếu để trống cả hai (PROXY_URL và ANTHROPIC_API_KEY) → Maika chạy engine
# offline (rule-based trong src/services/maika.js), không cần mạng.
